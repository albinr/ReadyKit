    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "prisma": "^6.10.1",
    "svelte": "^5.34.3",
    "svelte-check": "^4.1.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
