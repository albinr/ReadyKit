generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  kits         Kit[]
}

model Kit {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  status      KitStatus   @default(planning)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  syncVersion Int         @default(1)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections    Section[]
}

model Section {
  id          String   @id @default(uuid())
  kitId       String
  title       String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  syncVersion Int      @default(1)
  kit         Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  items       Item[]
}

model Item {
  id          String       @id @default(uuid())
  sectionId   String
  title       String
  description String?
  completed   Boolean      @default(false)
  required    Boolean      @default(true)
  priority    ItemPriority @default(medium)
  dueDate     DateTime?
  quantity    Int?
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  syncVersion Int          @default(1)
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

enum KitStatus {
  planning
  active
  completed
  archived
}

enum ItemPriority {
  low
  medium
  high
}

